<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requerido por el host de Android Auto para cualquier app que use la Car App Library. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- Habilita MapWithContentTemplate, necesaria para la categoria POI en la Fase 2 (Surface Lab). -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <!-- Fase 5: espejo de pantalla con MediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Fase 8: WebView propio en el auto (excepcion deliberada a "sin red" del plan
        original: ver RESULTS.md. Solo para cargar paginas elegidas por el usuario.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
            com.google.android.gms.car.application es la clave correcta para Android Auto
            proyectado (telefono + DHU/auto). com.android.automotive es solo para builds
            nativos de Android Automotive OS, que no es nuestro caso. Verificado contra el
            manifest real de android/car-samples (showcase/mobile).
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Nivel 5: es el minimo que introduce Header y MapController, usados en la Fase 2. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="5" />

        <!-- Los puntos de entrada al auto (GameActivity, CarAppService, MediaBrowserService)
             viven en el manifest de cada flavor: src/parked, src/templates, src/media. -->

        <!--
            Solo para control desde ADB durante las pruebas de laboratorio (ver RESULTS.md).
            exported=true es intencional: AutoLab nunca se distribuye.
        -->
        <receiver
            android:name=".surfacelab.SurfaceLabConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.personal.autolab.SET_CONFIG" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".virtuallab.VirtualDisplayLabConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.personal.autolab.SET_VIEW_CASE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".mirror.ScreenMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            Fase 7A: Activity de configuracion en el telefono. taskAffinity="" +
            excludeFromRecents evitan que comparta tarea con GameActivity (ver
            RESULTS.md Fase 7B sobre por que eso importa).
        -->
        <activity
            android:name=".mirror.ProjectionSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
