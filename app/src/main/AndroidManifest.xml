<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requerido por el host de Android Auto para cualquier app que use la Car App Library. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- Habilita MapWithContentTemplate, necesaria para la categoria POI en la Fase 2 (Surface Lab). -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <!-- Fase 5: espejo de pantalla con MediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
            com.google.android.gms.car.application es la clave correcta para Android Auto
            proyectado (telefono + DHU/auto). com.android.automotive es solo para builds
            nativos de Android Automotive OS, que no es nuestro caso. Verificado contra el
            manifest real de android/car-samples (showcase/mobile).
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Nivel 5: es el minimo que introduce Header y MapController, usados en la Fase 2. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="5" />

        <service
            android:name=".AutoLabCarAppService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!--
                    Categoria POI: permite MapWithContentTemplate y por lo tanto acceso a
                    Surface (ver Fase 2) sin los requisitos de una app de navegacion real.
                -->
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!--
            Solo para control desde ADB durante las pruebas de laboratorio (ver RESULTS.md).
            exported=true es intencional: AutoLab nunca se distribuye.
        -->
        <receiver
            android:name=".surfacelab.SurfaceLabConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.personal.autolab.SET_CONFIG" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".virtuallab.VirtualDisplayLabConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.personal.autolab.SET_VIEW_CASE" />
            </intent-filter>
        </receiver>

        <!--
            Fase 4: Activity parked (juego). LIMITACION CONFIRMADA (ver RESULTS.md): mientras
            este AutoLabCarAppService este presente en el manifest, el host de Android Auto
            no la abre desde su launcher (intenta bindear siempre al CarAppService). Solo se
            verifico funcionando end-to-end en una build de prueba sin el service.
        -->
        <activity
            android:name=".parkedgame.GameActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".mirror.ScreenMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".mirror.MirrorControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.personal.autolab.SET_MIRROR_MODE" />
                <action android:name="dev.personal.autolab.STOP_MIRROR" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
